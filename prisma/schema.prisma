// Mercatto CMS - Schema Prisma
// Banco de dados: MySQL (ADR-005)
// ORM: Prisma (ADR-004) — Prisma 6.15.x
//
// Este schema representa a FUNDAÇÃO do Sprint 1 + o módulo de
// Editorias (Sprint 2). Demais entidades (Noticia, Empresa, Midia,
// Publicidade, etc.) serão adicionadas nos próximos sprints, conforme
// o módulo correspondente for implementado (Modular Monolith).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Módulo: usuarios
// ---------------------------------------------------------------

enum Papel {
  SUPER_ADMINISTRADOR
  ADMINISTRADOR
  EDITOR_CHEFE
  EDITOR
  JORNALISTA
  COLUNISTA
  FOTOGRAFO
  COMERCIAL
}

model Usuario {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  senhaHash    String
  papel        Papel     @default(JORNALISTA)
  avatarUrl    String?
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  sessoes       Sessao[]
  contas        Conta[]
  logsAuditoria LogAuditoria[]

  noticiasComoAutor  Noticia[] @relation("NoticiasAutor")
  noticiasComoEditor Noticia[] @relation("NoticiasEditor")

  @@map("usuarios")
}

// ---------------------------------------------------------------
// Módulo: autenticação (compatível com Auth.js / Prisma Adapter)
// ---------------------------------------------------------------

model Conta {
  id              String  @id @default(cuid())
  usuarioId       String
  tipo            String
  provedor        String
  provedorContaId String
  refresh_token   String? @db.Text
  access_token    String? @db.Text
  expires_at      Int?
  token_type      String?
  scope           String?
  id_token        String? @db.Text
  session_state   String?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provedor, provedorContaId])
  @@map("contas")
}

model Sessao {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  usuarioId    String
  expires      DateTime

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("sessoes")
}

model TokenVerificacao {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("tokens_verificacao")
}

// ---------------------------------------------------------------
// Módulo: auditoria (transversal, requisito de segurança - 01.03.1 §19)
// ---------------------------------------------------------------

model LogAuditoria {
  id        String   @id @default(cuid())
  usuarioId String?
  acao      String
  detalhes  String?  @db.Text
  ip        String?
  criadoEm  DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("logs_auditoria")
}

// ---------------------------------------------------------------
// Módulo: editorial — Editorias (Sprint 2)
// ---------------------------------------------------------------
// Corresponde à "Organização Editorial" prevista em 01.03.1 (seção 7).

model Editoria {
  id             String   @id @default(cuid())
  nome           String
  slug           String   @unique
  descricao      String?  @db.Text
  cor            String?
  icone          String?
  imagemCapaUrl  String?
  ordem          Int      @default(0)
  ativo          Boolean  @default(true)
  seoTitle       String?
  seoDescription String?  @db.Text
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  noticias Noticia[]

  @@index([ordem])
  @@map("editorias")
}

// ---------------------------------------------------------------
// Módulo: editorial — Notícia (Sprint 3.1 — somente modelagem)
// ---------------------------------------------------------------
// Corresponde à Gestão Editorial / Página da Notícia (01.03.1 §4 e §12).
//
// Escopo desta etapa: apenas o model, enums, relacionamentos e índices.
// CRUD, repository, use cases, services, páginas, componentes, editor
// (Tiptap), upload e geração automática de SEO ficam para as próximas
// sub-etapas do Sprint 3, mediante autorização.
//
// Dependências ainda não modeladas (fora de escopo desta etapa):
// - Empresa (para "empresas relacionadas") — módulo ainda não iniciado.
// - Midia/Galeria (múltiplas imagens por notícia) — pertence ao módulo `midia`.
// - Tag — não solicitada nesta etapa.

enum StatusNoticia {
  RASCUNHO
  EM_EDICAO
  REVISAO
  AGUARDANDO_APROVACAO
  AGENDADA
  PUBLICADA
  ARQUIVADA
}

enum TipoConteudo {
  NOTICIA
  ARTIGO
  ENTREVISTA
  REPORTAGEM_ESPECIAL
}

model Noticia {
  id     String @id @default(cuid())
  titulo String
  slug   String @unique

  // Linha fina (subtítulo/deck) e resumo (chamada usada em listagens/cards)
  linhaFina String? @db.Text
  resumo    String? @db.Text

  // Corpo da notícia. Formato de armazenamento (HTML/JSON) será definido
  // quando o editor de conteúdo (Tiptap) for implementado.
  conteudo String @db.LongText

  tipo   TipoConteudo  @default(NOTICIA)
  status StatusNoticia @default(RASCUNHO)

  // Imagem de capa (galeria completa é responsabilidade futura do módulo midia)
  imagemDestaqueUrl     String?
  imagemDestaqueAlt     String?
  imagemDestaqueCredito String?

  destaque            Boolean @default(false)
  ordemDestaque       Int?
  visualizacoes       Int     @default(0)
  tempoLeituraMinutos Int?

  // SEO essencial (espelha os campos já existentes em Editoria).
  // Metadados adicionais (Open Graph, Twitter Cards, Schema.org) serão
  // derivados destes campos quando a geração de SEO for implementada.
  seoTitle        String?
  seoDescription  String? @db.Text
  seoCanonicalUrl String?

  publicadoEm  DateTime?
  agendadoPara DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  editoriaId String
  editoria   Editoria @relation(fields: [editoriaId], references: [id], onDelete: Restrict)

  autorId String
  autor   Usuario @relation("NoticiasAutor", fields: [autorId], references: [id], onDelete: Restrict)

  editorResponsavelId String?
  editorResponsavel   Usuario? @relation("NoticiasEditor", fields: [editorResponsavelId], references: [id], onDelete: SetNull)

  // Auto-relação N:N — "notícias relacionadas" (01.03.1 §12)
  relacionadas   Noticia[] @relation("NoticiasRelacionadas")
  relacionadaPor Noticia[] @relation("NoticiasRelacionadas")

  @@index([status])
  @@index([editoriaId])
  @@index([autorId])
  @@index([editorResponsavelId])
  @@index([publicadoEm])
  @@index([destaque, ordemDestaque])
  @@map("noticias")
}
