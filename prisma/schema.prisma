// Mercatto CMS - Schema Prisma
// Banco de dados: MySQL (ADR-005)
// ORM: Prisma (ADR-004) — Prisma 6.15.x
//
// Este schema representa a FUNDAÇÃO do Sprint 1 + o módulo de
// Editorias (Sprint 2). Demais entidades (Noticia, Empresa, Midia,
// Publicidade, etc.) serão adicionadas nos próximos sprints, conforme
// o módulo correspondente for implementado (Modular Monolith).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Módulo: usuarios
// ---------------------------------------------------------------

enum Papel {
  SUPER_ADMINISTRADOR
  ADMINISTRADOR
  EDITOR_CHEFE
  EDITOR
  JORNALISTA
  COLUNISTA
  FOTOGRAFO
  COMERCIAL
}

model Usuario {
  id            String    @id @default(cuid())
  nome          String
  email         String    @unique
  senhaHash     String
  papel         Papel     @default(JORNALISTA)
  avatarUrl     String?
  ativo         Boolean   @default(true)
  ultimoAcesso  DateTime?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  sessoes       Sessao[]
  contas        Conta[]
  logsAuditoria LogAuditoria[]

  @@map("usuarios")
}

// ---------------------------------------------------------------
// Módulo: autenticação (compatível com Auth.js / Prisma Adapter)
// ---------------------------------------------------------------

model Conta {
  id                String  @id @default(cuid())
  usuarioId         String
  tipo              String
  provedor          String
  provedorContaId   String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provedor, provedorContaId])
  @@map("contas")
}

model Sessao {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  usuarioId    String
  expires      DateTime

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("sessoes")
}

model TokenVerificacao {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("tokens_verificacao")
}

// ---------------------------------------------------------------
// Módulo: auditoria (transversal, requisito de segurança - 01.03.1 §19)
// ---------------------------------------------------------------

model LogAuditoria {
  id         String   @id @default(cuid())
  usuarioId  String?
  acao       String
  detalhes   String?  @db.Text
  ip         String?
  criadoEm   DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("logs_auditoria")
}

// ---------------------------------------------------------------
// Módulo: editorial — Editorias (Sprint 2)
// ---------------------------------------------------------------
// Corresponde à "Organização Editorial" prevista em 01.03.1 (seção 7).
// A relação com o model Noticia será adicionada quando o módulo
// editorial de notícias for implementado (Sprint 3+); até lá, a
// contagem de notícias por editoria é exibida como 0 na interface.

model Editoria {
  id               String   @id @default(cuid())
  nome             String
  slug             String   @unique
  descricao        String?  @db.Text
  cor              String?
  icone            String?
  imagemCapaUrl    String?
  ordem            Int      @default(0)
  ativo            Boolean  @default(true)
  seoTitle         String?
  seoDescription   String?  @db.Text
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  @@index([ordem])
  @@map("editorias")
}

