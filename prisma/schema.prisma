// Mercatto CMS - Schema Prisma
// Banco de dados: MySQL
// ORM: Prisma 6.15.x

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===============================================================
// MÓDULO: USUÁRIOS
// ===============================================================

enum Papel {
  SUPER_ADMINISTRADOR
  ADMINISTRADOR
  EDITOR_CHEFE
  EDITOR
  JORNALISTA
  COLUNISTA
  FOTOGRAFO
  COMERCIAL
}

model Usuario {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  senhaHash    String
  papel        Papel     @default(JORNALISTA)
  avatarUrl    String?
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  sessoes       Sessao[]
  contas        Conta[]
  logsAuditoria LogAuditoria[]

  noticiasComoAutor  Noticia[] @relation("NoticiasAutor")
  noticiasComoEditor Noticia[] @relation("NoticiasEditor")

  @@map("usuarios")
}

// ===============================================================
// MÓDULO: AUTENTICAÇÃO
// Compatível com Auth.js / Prisma Adapter
// ===============================================================

model Conta {
  id              String  @id @default(cuid())
  usuarioId       String
  tipo            String
  provedor        String
  provedorContaId String
  refresh_token   String? @db.Text
  access_token    String? @db.Text
  expires_at      Int?
  token_type      String?
  scope           String?
  id_token        String? @db.Text
  session_state   String?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provedor, provedorContaId])
  @@map("contas")
}

model Sessao {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  usuarioId    String
  expires      DateTime

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("sessoes")
}

model TokenVerificacao {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("tokens_verificacao")
}

// ===============================================================
// MÓDULO: AUDITORIA
// ===============================================================

model LogAuditoria {
  id        String   @id @default(cuid())
  usuarioId String?
  acao      String
  detalhes  String?  @db.Text
  ip        String?
  criadoEm  DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("logs_auditoria")
}

// ===============================================================
// MÓDULO: EDITORIAL — EDITORIAS
// ===============================================================

model Editoria {
  id             String   @id @default(cuid())
  nome           String
  slug           String   @unique
  descricao      String?  @db.Text
  cor            String?
  icone          String?
  imagemCapaUrl  String?
  ordem          Int      @default(0)
  ativo          Boolean  @default(true)
  seoTitle       String?
  seoDescription String?  @db.Text
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  noticias Noticia[]

  @@index([ordem])
  @@map("editorias")
}

// ===============================================================
// MÓDULO: EDITORIAL — NOTÍCIAS
// ===============================================================

enum StatusNoticia {
  RASCUNHO
  EM_EDICAO
  REVISAO
  AGUARDANDO_APROVACAO
  AGENDADA
  PUBLICADA
  ARQUIVADA
}

enum TipoConteudo {
  NOTICIA
  ARTIGO
  ENTREVISTA
  REPORTAGEM_ESPECIAL
}

model Noticia {
  id     String @id @default(cuid())
  titulo String
  slug   String @unique

  // Linha fina e resumo
  linhaFina String? @db.Text
  resumo    String? @db.Text

  // Corpo da notícia
  conteudo String @db.LongText

  tipo   TipoConteudo  @default(NOTICIA)
  status StatusNoticia @default(RASCUNHO)

  // Imagem de destaque
  imagemDestaqueUrl     String?
  imagemDestaqueAlt     String?
  imagemDestaqueCredito String?

  // Destaques
  destaque            Boolean @default(false)
  ordemDestaque       Int?
  visualizacoes       Int     @default(0)
  tempoLeituraMinutos Int?

  // SEO
  seoTitle        String?
  seoDescription  String? @db.Text
  seoCanonicalUrl String?

  // Datas
  publicadoEm  DateTime?
  agendadoPara DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  // Editoria
  editoriaId String
  editoria   Editoria @relation(fields: [editoriaId], references: [id], onDelete: Restrict)

  // Autor
  autorId String
  autor   Usuario @relation("NoticiasAutor", fields: [autorId], references: [id], onDelete: Restrict)

  // Editor responsável
  editorResponsavelId String?
  editorResponsavel   Usuario? @relation("NoticiasEditor", fields: [editorResponsavelId], references: [id], onDelete: SetNull)

  // Notícias relacionadas — auto-relação N:N
  relacionadas   Noticia[] @relation("NoticiasRelacionadas")
  relacionadaPor Noticia[] @relation("NoticiasRelacionadas")

  @@index([status])
  @@index([editoriaId])
  @@index([autorId])
  @@index([editorResponsavelId])
  @@index([publicadoEm])
  @@index([destaque, ordemDestaque])
  @@map("noticias")
}

// ===============================================================
// MÓDULO: EMPRESAS
// ===============================================================

enum StatusEmpresa {
  ATIVA
  INATIVA
}

model Empresa {
  id String @id @default(cuid())

  // Identificação
  nomeEmpresarial String
  slug            String @unique

  // Identidade visual
  logotipoUrl       String?
  fotografiaCapaUrl String?

  // Localização e segmento
  segmentoAtuacao String?
  cidade          String?
  estado          String?

  // Institucional
  descricaoInstitucional String? @db.Text

  // Presença digital
  siteOficial  String?
  redesSociais String? @db.Text
  contatos     String? @db.Text

  // Localização
  localizacao String? @db.Text

  // Selos / certificações / ESG
  selosCertificacoes String? @db.Text
  esg                String? @db.Text

  // Status
  status StatusEmpresa @default(ATIVA)

  // Auditoria temporal
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status])
  @@index([cidade])
  @@index([estado])
  @@map("empresas")
}